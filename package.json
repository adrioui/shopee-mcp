{
  "name": "@bintangtimurlangit/shopee-mcp",
  "version": "0.3.0",
  "description": "An MCP server for exploring Shopee — product search and prices via an authenticated browser session. Discovery only, no seller features.",
  "author": "bintangtimurlangit",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bintangtimurlangit/shopee-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/bintangtimurlangit/shopee-mcp/issues"
  },
  "homepage": "https://github.com/bintangtimurlangit/shopee-mcp#readme",
  "bin": {
    "shopee-mcp": "build/index.js",
    "shopee-mcp-login": "build/login.js"
  },
  "scripts": {
    "clean": "rm -rf build",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "login": "tsx src/login.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit && pnpm run test:smoke",
    "test:unit": "vitest run",
    "test:smoke": "tsx test/smoke.ts",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build"
  },
  "lint-staged": {
    "*.{js,json,md,yml,yaml}": "prettier --write",
    "*.ts": "oxlint --fix"
  },
  "files": [
    "build",
    ".env.example",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shopee",
    "indonesia",
    "ecommerce",
    "marketplace",
    "product-search",
    "discovery"
  ],
  "dependencies": {
    "@effect/platform-node": "^4.1.6",
    "effect": "^4.1.6",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@effect/vitest": "^4.1.6",
    "@oxlint/plugins": "1.95.0",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxlint": "1.95.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
